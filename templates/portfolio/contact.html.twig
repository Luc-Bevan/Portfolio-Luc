{% extends 'portfolio/base.html.twig' %}

{% block body %}
<div class="mt-5 container-lg">
    <div class="row">
        <div class="col-md-6">
            <h2>{{ 'contact.title'|trans({}, 'messages', app.request.locale) }}</h2>
            <p class="text-muted">{{ 'contact.description'|trans({}, 'messages', app.request.locale) }}</p>
            <ul class="list-unstyled mt-3">
                <li><strong>{{ 'personal.name_full'|trans({}, 'messages', app.request.locale) }}</strong></li>
                <li>{{ 'personal.email'|trans({}, 'messages', app.request.locale) }}</li>
                <li>{{ 'personal.phone'|trans({}, 'messages', app.request.locale) }}</li>
                <li>{{ 'personal.address'|trans({}, 'messages', app.request.locale) }}</li>
            </ul>
        </div>
        <div class="col-md-6">
            <h3>{{ 'contact.form.name'|trans({}, 'messages', app.request.locale) }}</h3>
            <form method="post" action="#" class="mt-3">
                <div class="mb-3">
                    <label for="name" class="form-label">{{ 'contact.form.name'|trans({}, 'messages', app.request.locale) }}</label>
                    <input type="text" class="form-control" id="name" name="name" placeholder="{{ 'contact.form.name_placeholder'|trans({}, 'messages', app.request.locale) }}">
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">{{ 'contact.form.email'|trans({}, 'messages', app.request.locale) }}</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="{{ 'contact.form.email_placeholder'|trans({}, 'messages', app.request.locale) }}">
                </div>
                <div class="mb-3">
                    <label for="message" class="form-label">{{ 'contact.form.message'|trans({}, 'messages', app.request.locale) }}</label>
                    <textarea class="form-control" id="message" name="message" rows="3" placeholder="{{ 'contact.form.message_placeholder'|trans({}, 'messages', app.request.locale) }}"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">{{ 'contact.form.submit'|trans({}, 'messages', app.request.locale) }}</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
