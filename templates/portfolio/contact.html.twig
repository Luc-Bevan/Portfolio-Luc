{% extends 'portfolio/base.html.twig' %}

{% block title %}{{ 'contact.title'|trans({}, 'messages', app.request.locale) }}{% endblock %}

{% block body %}
<div class="container-lg py-5 animate__animated animate__fadeIn">
    
    {# Titre centré #}
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-light">{{ 'contact.title'|trans({}, 'messages', app.request.locale) }}</h1>
        <p class="text-muted lead">{{ 'contact.description'|trans({}, 'messages', app.request.locale) }}</p>
    </div>

    {# Contenu centré sans bordures/boîtes #}
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            
            {# Nom en grand #}
            <h2 class="text-primary mb-5">{{ 'personal.name_full'|trans({}, 'messages', app.request.locale) }}</h2>

            {# Liste des coordonnées aérée #}
            <div class="d-flex flex-column gap-4 align-items-center">
                
                {# Email #}
                <div class="d-flex flex-column align-items-center">
                    <div class="mb-2 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-envelope-fill" viewBox="0 0 16 16">
                            <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"/>
                        </svg>
                    </div>
                    <h3 class="h5 text-light mb-1">{{ 'contact.form.email'|trans({}, 'messages', app.request.locale) }}</h3>
                    <a href="mailto:{{ 'personal.email'|trans({}, 'messages', app.request.locale) }}" class="text-muted text-decoration-none fs-5 hover-text-light">
                        {{ 'personal.email'|trans({}, 'messages', app.request.locale) }}
                    </a>
                </div>

                {# Téléphone #}
                <div class="d-flex flex-column align-items-center mt-3">
                    <div class="mb-2 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-telephone-fill" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
                        </svg>
                    </div>
                    <a href="tel:{{ 'personal.phone'|trans({}, 'messages', app.request.locale)|replace({' ': ''}) }}" class="text-muted text-decoration-none fs-5 hover-text-light">
                        {{ 'personal.phone'|trans({}, 'messages', app.request.locale) }}
                    </a>
                </div>

                {# Adresse #}
                <div class="d-flex flex-column align-items-center mt-3">
                    <div class="mb-2 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
                            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                        </svg>
                    </div>
                    <span class="text-muted fs-5 text-center">
                        {{ 'personal.address'|trans({}, 'messages', app.request.locale) }}
                    </span>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    /* Petit effet hover pour rendre les liens plus interactifs */
    .hover-text-light:hover {
        color: var(--text-strong) !important;
        transition: color 0.3s ease;
    }
</style>
{% endblock %}