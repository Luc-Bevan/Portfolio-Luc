{% extends 'portfolio/base.html.twig' %}

{% block title %}{{ 'cv.title'|trans({}, 'messages', app.request.locale) }}{% endblock %}

{% block body %}
<div class="container-lg py-5 animate__animated animate__fadeIn">
    
    {# 1. En-tête centré (Header) #}
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-light mb-2">{{ 'personal.name_full'|trans({}, 'messages', app.request.locale) }}</h1>
        <h2 class="h4 text-primary mb-4">{{ 'cv.header'|trans({}, 'messages', app.request.locale) }}</h2>
        
        {# Contact Info en ligne #}
        <div class="d-flex justify-content-center flex-wrap gap-3 text-muted mb-3" style="font-size: 1.1rem;">
             <span class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope-fill" viewBox="0 0 16 16"><path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"/></svg>
                {{ 'personal.email'|trans({}, 'messages', app.request.locale) }}
             </span>
             <span class="d-none d-md-inline">•</span>
             <span class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone-fill" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/></svg>
                {{ 'personal.phone'|trans({}, 'messages', app.request.locale) }}
             </span>
             <span class="d-none d-md-inline">•</span>
             <span class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>
                {{ 'personal.address'|trans({}, 'messages', app.request.locale) }}
             </span>
        </div>
        
        <div class="d-flex justify-content-center flex-wrap gap-3 text-muted small">
            <span>{{ 'personal.birth'|trans({}, 'messages', app.request.locale) }}</span>
             <span>•</span>
            <span>{{ 'personal.license'|trans({}, 'messages', app.request.locale) }}</span>
             <span>•</span>
            <span>{{ 'personal.languages'|trans({}, 'messages', app.request.locale) }}</span>
        </div>
    </div>

    {# Contenu Principal centré sur la page #}
    <div class="row justify-content-center">
        <div class="col-lg-10">
            
            {# 2. Profil #}
            <section class="mb-5 text-center bg-dark p-4 rounded shadow-sm border border-secondary">
                 <h3 class="mb-3 text-light">{{ 'profile.title'|trans({}, 'messages', app.request.locale) }}</h3>
                 <p class="text-muted lead mb-0">{{ 'profile.desc'|trans({}, 'messages', app.request.locale) }}</p>
            </section>

            {# 3. Formation #}
            <section class="mb-5">
                 <div class="d-flex align-items-center mb-4">
                    <h3 class="text-light m-0">{{ 'formation.title'|trans({}, 'messages', app.request.locale) }}</h3>
                    <div class="ms-3 flex-grow-1 border-bottom border-secondary" style="opacity: 0.3;"></div>
                 </div>
                 <div class="card bg-dark border-secondary shadow-sm mb-3">
                    <div class="card-body d-flex align-items-center">
                         <div class="me-3 text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-mortarboard" viewBox="0 0 16 16"><path d="M8.211 2.047a.5.5 0 0 0-.422 0l-7.5 3.5a.5.5 0 0 0 .025.917l7.5 3a.5.5 0 0 0 .372 0L14 7.14V13a1 1 0 0 0-1-1v2h3v-2a1 1 0 0 0-1-1V6.739l.686-.275a.5.5 0 0 0 .025-.917l-7.5-3.5Z"/><path d="M4.176 9.032a.5.5 0 0 0-.656.327l-.5 1.7a.5.5 0 0 0 .294.605l4.5 1.8a.5.5 0 0 0 .372 0l4.5-1.8a.5.5 0 0 0 .294-.605l-.5-1.7a.5.5 0 0 0-.656-.327L8 10.466 4.176 9.032Z"/></svg>
                         </div>
                         <div>
                            <p class="mb-0 text-light lead">{{ 'formation.item1'|trans({}, 'messages', app.request.locale) }}</p>
                         </div>
                    </div>
                 </div>
            </section>

            {# 4. Expérience - Grille de cartes #}
            <section class="mb-5">
                 <div class="d-flex align-items-center mb-4">
                    <h3 class="text-light m-0">{{ 'experience.title'|trans({}, 'messages', app.request.locale) }}</h3>
                    <div class="ms-3 flex-grow-1 border-bottom border-secondary" style="opacity: 0.3;"></div>
                 </div>
                 
                 <div class="row g-4">
                    {# Item 1 #}
                    <div class="col-md-6">
                        <div class="card bg-dark border-secondary h-100 shadow-sm card-hover">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title text-primary mb-0">{{ 'experience.item1.title'|trans({}, 'messages', app.request.locale) }}</h5>
                                    <span class="badge bg-secondary">{{ 'experience.item1.date'|trans({}, 'messages', app.request.locale) }}</span>
                                </div>
                                <p class="card-text fw-bold text-light mb-2">{{ 'experience.item1.company'|trans({}, 'messages', app.request.locale) }}</p>
                                <p class="card-text text-muted small">{{ 'experience.item1.desc'|trans({}, 'messages', app.request.locale) }}</p>
                            </div>
                        </div>
                    </div>
                    {# Item 2 #}
                     <div class="col-md-6">
                        <div class="card bg-dark border-secondary h-100 shadow-sm card-hover">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title text-primary mb-0">{{ 'experience.item2.title'|trans({}, 'messages', app.request.locale) }}</h5>
                                    <span class="badge bg-secondary">{{ 'experience.item2.date'|trans({}, 'messages', app.request.locale) }}</span>
                                </div>
                                <p class="card-text fw-bold text-light mb-2">{{ 'experience.item2.company'|trans({}, 'messages', app.request.locale) }}</p>
                                <p class="card-text text-muted small">{{ 'experience.item2.desc'|trans({}, 'messages', app.request.locale) }}</p>
                            </div>
                        </div>
                    </div>
                    {# Item 3 #}
                     <div class="col-md-6">
                        <div class="card bg-dark border-secondary h-100 shadow-sm card-hover">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title text-primary mb-0">{{ 'experience.item3.title'|trans({}, 'messages', app.request.locale) }}</h5>
                                    <span class="badge bg-secondary">{{ 'experience.item3.date'|trans({}, 'messages', app.request.locale) }}</span>
                                </div>
                                <p class="card-text fw-bold text-light mb-2">{{ 'experience.item3.company'|trans({}, 'messages', app.request.locale) }}</p>
                                <p class="card-text text-muted small">{{ 'experience.item3.desc'|trans({}, 'messages', app.request.locale) }}</p>
                            </div>
                        </div>
                    </div>
                    {# Item 4 #}
                     <div class="col-md-6">
                        <div class="card bg-dark border-secondary h-100 shadow-sm card-hover">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title text-primary mb-0">{{ 'experience.item4.title'|trans({}, 'messages', app.request.locale) }}</h5>
                                    <span class="badge bg-secondary">{{ 'experience.item4.date'|trans({}, 'messages', app.request.locale) }}</span>
                                </div>
                                <p class="card-text fw-bold text-light mb-2">{{ 'experience.item4.company'|trans({}, 'messages', app.request.locale) }}</p>
                                <p class="card-text text-muted small">{{ 'experience.item4.desc'|trans({}, 'messages', app.request.locale) }}</p>
                            </div>
                        </div>
                    </div>
                 </div>
            </section>

             {# 5. Compétences #}
            <section class="mb-5 text-center">
                 <div class="d-flex align-items-center mb-4">
                    <h3 class="text-light m-0">{{ 'cv.skills'|trans({}, 'messages', app.request.locale) }}</h3>
                    <div class="ms-3 flex-grow-1 border-bottom border-secondary" style="opacity: 0.3;"></div>
                 </div>
                 <div class="d-flex justify-content-center flex-wrap gap-3">
                    <span class="badge bg-primary fs-6 py-2 px-4 rounded-pill shadow-sm animate__animated animate__zoomIn">{{ 'cv.skill1'|trans({}, 'messages', app.request.locale) }}</span>
                    <span class="badge bg-primary fs-6 py-2 px-4 rounded-pill shadow-sm animate__animated animate__zoomIn" style="animation-delay: 0.1s;">{{ 'cv.skill2'|trans({}, 'messages', app.request.locale) }}</span>
                    <span class="badge bg-primary fs-6 py-2 px-4 rounded-pill shadow-sm animate__animated animate__zoomIn" style="animation-delay: 0.2s;">{{ 'cv.skill3'|trans({}, 'messages', app.request.locale) }}</span>
                 </div>
            </section>
        </div>
    </div>
</div>
{% endblock %}