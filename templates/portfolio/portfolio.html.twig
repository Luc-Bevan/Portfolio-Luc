{% extends 'portfolio/base.html.twig' %}

{% block title %}{{ 'portfolio.title'|trans({}, 'messages', app.request.locale) }}{% endblock %}

{% block body %}
<div class="container-lg text-light py-5">
    <h1 class="mb-3">{{ 'portfolio.title'|trans({}, 'messages', app.request.locale) }}</h1>
    <p class="lead text-muted mb-4">{{ 'portfolio.description'|trans({}, 'messages', app.request.locale) }}</p>

    {# --- SECTION PROJETS --- #}
    <section class="mb-5">
        <h2 class="mb-3">{{ 'portfolio.projects_title'|trans({}, 'messages', app.request.locale) }}</h2>
        <div class="row g-4">
            {% if projects is defined and projects is not empty %}
                {% for project in projects %}
                <div class="col-md-4 animate__animated animate__fadeInUp">
                    <div class="card">
                        {% if project.image is defined and project.image %}
                            <img src="{{ asset(project.image) }}" class="card-img-top" alt="{{ project.title }}">
                        {% else %}
                            <img src="{{ asset('images/project' ~ loop.index ~ '.jpg') }}" class="card-img-top" alt="Project {{ loop.index }}">
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title">{{ project.title }}</h5>
                            <p class="card-text text-muted">{{ project.desc }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                {# Fallback to three default slots #}
                {% for i in 1..3 %}
                <div class="col-md-4 animate__animated animate__fadeInUp">
                    <div class="card">
                        <img src="{{ asset('images/project' ~ i ~ '.jpg') }}" class="card-img-top" alt="Project {{ i }}">
                        <div class="card-body">
                             <h5 class="card-title">{{ ('portfolio.project' ~ i ~ '.title')|trans({}, 'messages', app.request.locale) }}</h5>
                             <p class="card-text text-muted">{{ ('portfolio.project' ~ i ~ '.desc')|trans({}, 'messages', app.request.locale) }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% endif %}
        </div>
    </section>

    {# --- SECTION COMPÉTENCES (Mise à jour avec Tooltips de traduction) --- #}
    {% if portfolio_data is defined and portfolio_data.skills is not empty %}
    <section class="mb-5">
        <h2 class="mb-3">{{ 'portfolio.skills_title'|trans({}, 'messages', app.request.locale) }}</h2>
        <div class="row g-4">
            {% for comp_name, comp_data in portfolio_data.skills %}
            <div class="col-md-6 animate__animated animate__fadeInUp">
                <a href="https://drive.google.com/drive/folders/1lArajKwxEFNdgnpU-ziNkEgSQvheQ0Ad?dmr=1&ec=wgc-drive-%5Bmodule%5D-goto" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                    <div class="card bg-dark border-secondary h-100">
                        <div class="card-body text-reset">
                            
                            {# Titre de la compétence (RT) avec Infobulle au survol #}
                            <h5 class="card-title text-light"
                                data-bs-toggle="tooltip" 
                                data-bs-placement="top" 
                                style="cursor: help;"
                                title="{{ ('portfolio.tooltip.' ~ comp_name)|trans({}, 'messages', app.request.locale) }}">
                                
                                {{ ('portfolio.competence.' ~ comp_name)|trans({}, 'messages', app.request.locale) }}
                                <i class="bi bi-info-circle ms-2 small text-muted" style="font-size: 0.7em;"></i>
                            </h5>

                        <ul class="list-unstyled small">
                            {% for apprentissage in comp_data.apprentissages %}
                            <li class="mb-3 p-2 rounded" style="background-color: rgba(255,255,255,0.05); border-left: 3px solid #007bff;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        
                                        {# Badge du Code (AC) avec Infobulle au survol #}
                                        <span class="badge bg-primary me-2" 
                                              style="cursor: help;"
                                              data-bs-toggle="tooltip" 
                                              data-bs-placement="right" 
                                              title="{{ ('portfolio.tooltip.' ~ apprentissage.code)|trans({}, 'messages', app.request.locale) }}">
                                            {{ apprentissage.code }}
                                        </span>

                                        <span class="text-light">{{ ('portfolio.apprentissage.' ~ apprentissage.code|replace({'.': '.'})|replace({' ': ''}))|trans({}, 'messages', app.request.locale) }}</span>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">{{ 'portfolio.level'|trans({}, 'messages', app.request.locale) }}: 
                                        <span class="badge" style="background-color: {{ apprentissage.level >= 1 ? '#28a745' : '#6c757d' }};">
                                            {{ apprentissage.level }}/4
                                        </span>
                                        </small>
                                        
                                        {% if apprentissage.status %}
                                            {% set status_color = 'bg-secondary' %}
                                            {% if apprentissage.status == 'validated' %}
                                                {% set status_color = 'bg-success' %}
                                            {% elseif apprentissage.status == 'in_progress' %}
                                                {% set status_color = 'bg-primary' %}
                                            {% elseif apprentissage.status == 'not_started' %}
                                                {% set status_color = 'bg-warning text-dark' %}
                                            {% endif %}

                                            <small class="badge {{ status_color }} ms-2">
                                                {{ ('portfolio.status.' ~ apprentissage.status)|trans({}, 'messages', app.request.locale) }}
                                            </small>
                                        {% endif %}
                                    </div>
                                </div>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                </a>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}
</div>

{# === SCRIPT D'ACTIVATION DES TOOLTIPS === #}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    });
</script>

{% endblock %}